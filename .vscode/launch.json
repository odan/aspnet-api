{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Demo.Api: Development",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "dotnet",
      "args": [
        "${workspaceFolder}/Demo.Api/bin/Debug/net10.0/Demo.Api.dll",
        "--urls",
        "http://localhost:5198"
      ],
      "cwd": "${workspaceFolder}/Demo.Api",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "Now listening on: (https?://\\S+)",
        "uriFormat": "%s/swagger/index.html"
      },
      "console": "integratedTerminal",
      "stopAtEntry": false
    }
  ]
}
